<!doctype html>
<html lang="bg">
<head><meta charset="utf-8"></head>
<body style="font-family: sans-serif; line-height: 1.5; color: #252525;">
  <p>Здравейте{{if .UserName}}, {{.UserName}}{{end}},</p>
