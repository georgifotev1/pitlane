# Copy to .env for local development. The web process reads environment
# variables directly; no dotenv package is linked into the binary.
PORT=4000
ENV=development

# Runtime connection. Tenant isolation is enforced in internal/store, not by
# the database, so every query there filters on tenant_id.
DSN=postgres://pitlane:pitlane@localhost:5432/pitlane?sslmode=disable
# Optional: defaults to DSN. Set it only when migrations need a different
# endpoint from the application - for example the direct (non-pooled) endpoint
# on a serverless Postgres provider.
# MIGRATE_DSN=

# Welcome and password-reset account email. Local development uses Mailpit.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=hello@pitlane.local
APP_BASE_URL=http://localhost:4000

# Production example (Neon: use the direct endpoint for MIGRATE_DSN if you
# point DSN at the pooled one).
# DSN=postgres://neondb_owner:<password>@ep-xxx.eu-central-1.aws.neon.tech/pitlane?sslmode=require
