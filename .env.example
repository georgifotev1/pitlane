# Copy to .env for local dev (make dev does this automatically). Never commit .env.

PORT=4000
ENV=development
# Runtime DSN: the API connects as the non-owner app role (RLS enforced).
DSN=postgres://pitlane_app:pitlane_app@localhost:5432/pitlane?sslmode=disable
# Migration DSN: goose/River run as the database owner to create roles/tables.
MIGRATE_DSN=postgres://pitlane:pitlane@localhost:5432/pitlane?sslmode=disable

# Sessions (used from Phase 2 — scs). Secret must be 32+ random bytes in production.
SESSION_SECRET=dev-only-insecure-secret-change-me
SESSION_LIFETIME=12h

# SMTP (used from Phase 7 — Mailpit in dev).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=offers@pitlane.local

# Object storage (used from Phase 9 — MinIO in dev, Cloudflare R2 in prod).
R2_ENDPOINT=http://localhost:9000
R2_REGION=auto
R2_BUCKET=pitlane-dev
R2_ACCESS_KEY_ID=pitlane
R2_SECRET_ACCESS_KEY=pitlane-dev-secret

# Public origin of the SPA (used from Phase 10 — password-reset/invite email links).
# Dev: the Vite dev server. Prod: your real domain, e.g. https://pitlane.example.com
APP_BASE_URL=http://localhost:5173

# Comma-separated CIDRs whose X-Forwarded-For is trusted (rate limiting). Empty in dev.
TRUSTED_PROXY=
