# Copy to .env for local development. The web process reads environment
# variables directly; no dotenv package is linked into the binary.
PORT=4000
ENV=development

# Runtime role. The migrations create pitlane_app and enforce tenant RLS.
DSN=postgres://pitlane_app:pitlane_app@localhost:5432/pitlane?sslmode=disable
# Owner role used only by the explicit migration command.
MIGRATE_DSN=postgres://pitlane:pitlane@localhost:5432/pitlane?sslmode=disable

# Welcome and password-reset account email. Local development uses Mailpit.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=hello@pitlane.local
APP_BASE_URL=http://localhost:4000

# Production example (use the direct Neon endpoint):
# DSN=postgres://pitlane_app:<password>@ep-xxx.eu-central-1.aws.neon.tech/pitlane?sslmode=require
# MIGRATE_DSN=postgres://pitlane:<password>@ep-xxx.eu-central-1.aws.neon.tech/pitlane?sslmode=require
